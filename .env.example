# GitHub Personal Access Token (optional, increases API rate limits)
# Create at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# Google AI Studio API Key for Gemma 4 integration
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Set to "true" to disable AI analysis entirely
PRISM_AI_DISABLED=false

